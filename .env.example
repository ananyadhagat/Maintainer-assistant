# GEMINI_API_KEY: Required for Gemini / Gemma API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMMA_MODEL: Configured Gemma 4 model for all inference operations.
# Options: gemma-4-26b-a4b-it, gemma-4-31b-it
GEMMA_MODEL="gemma-4-26b-a4b-it"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: (Optional) GitHub Personal Access Token to increase GitHub REST API rate limits from 60 to 5000 requests/hr.
GITHUB_TOKEN=""
